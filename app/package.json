{
  "name": "estante-app",
  "version": "1.0.0",
  "description": "Estante de Ebooks - app desktop para catalogar e ler ebooks",
  "main": "dist/main/main/main.js",
  "author": "voce",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n MAIN,RENDERER -c blue,green \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:all": "concurrently -k -n VITE,ELECTRON -c blue,green \"npx vite\" \"npm:electron:dev\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --sourceMap",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "electron:dev": "npm run build && cross-env NODE_ENV=development electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.408.0",
    "marked": "^18.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.estante.app",
    "productName": "Estante de Ebooks",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Estante de Ebooks",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.0": true
  }
}
